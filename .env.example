# JWT Auth Service Environment Configuration
# Copy this file to .env and modify the values

# JWT Configuration
# IMPORTANT: Change this in production! and key need to be >= 32-byte
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# External User Service Configuration
# URL of the external user service for authentication
USER_SERVICE_URL=http://localhost:8001
# Optional API key for authenticating with the user service
USER_SERVICE_API_KEY=
# Timeout for user service requests in seconds
USER_SERVICE_TIMEOUT=10

# Redis Configuration
# Redis connection settings for token storage
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Prefix for all Redis keys (useful for sharing Redis instance)
REDIS_PREFIX=jwt_auth:

# Token Storage Configuration
# Whether to rotate refresh tokens on each use
ROTATE_REFRESH_TOKEN=true
# Maximum active refresh tokens per user (0 = unlimited)
MAX_ACTIVE_REFRESH_PER_USER=5

# Logging Configuration
LOG_LEVEL=INFO
